<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tunetastic_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/tunetastic_widget_artwork_background"
        android:contentDescription="TuneTastic"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/icon_default" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tunetastic_widget_status_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#B9FFD1"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:layout_marginTop="5dp"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3B3B3"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/tunetastic_widget_open_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:text="OPEN"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
