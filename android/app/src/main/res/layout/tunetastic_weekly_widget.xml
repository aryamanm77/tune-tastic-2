<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weekly_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tunetastic_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR WEEK" android:textColor="#B9FFD1" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Keep the rhythm going" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/weekly_songs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1DB954" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="songs explored" android:textColor="#B3B3B3" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/weekly_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFD45C" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="active days" android:textColor="#B3B3B3" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
